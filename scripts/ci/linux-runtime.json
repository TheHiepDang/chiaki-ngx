{
  "schema": 1,
  "description": "Ubuntu 24.04 CI desktop baseline; equivalent system interfaces and vendor drivers required on SteamOS. Explicit host ABI boundary from pinned linuxdeploy exclusions plus upstream LibVA/Vulkan exclusions. Everything else must be bundled.",
  "host_groups": [
    {
      "purpose": "system C/C++ runtime and basic desktop services",
      "ubuntu_packages": ["libc6", "libstdc++6", "libgcc-s1", "zlib1g", "libexpat1", "libuuid1", "libcom-err2", "libgpg-error0"],
      "sonames": ["libc.so.6", "libm.so.6", "libdl.so.2", "libpthread.so.0", "librt.so.1", "libresolv.so.2", "ld-linux-x86-64.so.2", "libstdc++.so.6", "libgcc_s.so.1", "libz.so.1", "libexpat.so.1", "libuuid.so.1", "libcom_err.so.2", "libgpg-error.so.0"]
    },
    {
      "purpose": "desktop window, font and audio interfaces",
      "ubuntu_packages": ["libx11-6", "libx11-xcb1", "libxcb1", "libxcb-dri3-0", "libwayland-client0", "libfontconfig1", "libfreetype6", "libasound2t64"],
      "sonames": ["libX11.so.6", "libX11-xcb.so.1", "libxcb.so.1", "libxcb-dri3.so.0", "libwayland-client.so.0", "libfontconfig.so.1", "libfreetype.so.6", "libasound.so.2"]
    },
    {
      "purpose": "host graphics dispatch and video acceleration interfaces (not vendor drivers)",
      "ubuntu_packages": ["libvulkan1", "libegl1", "libgl1", "libglx0", "libopengl0", "libglvnd0", "libgbm1", "libdrm2", "libva2", "libva-drm2", "libva-x11-2"],
      "sonames": ["libvulkan.so.1", "libEGL.so.1", "libGL.so.1", "libGLX.so.0", "libOpenGL.so.0", "libGLdispatch.so.0", "libgbm.so.1", "libdrm.so.2", "libva.so.2", "libva-drm.so.2", "libva-x11.so.2"]
    }
  ]
}
