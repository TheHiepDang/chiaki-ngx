# One source of truth for the app, native resources and packages.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/Version.txt")
file(READ "${CMAKE_CURRENT_LIST_DIR}/Version.txt" CHIAKI_VERSION)
string(STRIP "${CHIAKI_VERSION}" CHIAKI_VERSION)
if(NOT CHIAKI_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
    message(FATAL_ERROR "VERSION must be major.minor[.patch][-prerelease], without a v prefix")
endif()
set(CHIAKI_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(CHIAKI_VERSION_MINOR "${CMAKE_MATCH_2}")
set(CHIAKI_VERSION_PATCH "${CMAKE_MATCH_4}")
if(CHIAKI_VERSION_PATCH STREQUAL "")
    set(CHIAKI_VERSION_PATCH 0)
endif()
foreach(PART MAJOR MINOR PATCH)
    if(CHIAKI_VERSION_${PART} GREATER 65535)
        message(FATAL_ERROR "Version components must fit Windows version resources")
    endif()
endforeach()
